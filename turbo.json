{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "android": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "env": ["DATABASE_URL", "EXPO_PUBLIC_API_URL", "HOST", "PORT"],
      "persistent": true
    },
    "ios": {
      "cache": false
    },
    "ios:dev-client": {
      "cache": false
    },
    "lint": {},
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "web": {
      "cache": false,
      "persistent": true
    }
  }
}
