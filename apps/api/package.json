{
  "name": "@snap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:control": "tsx scripts/benchmark-control-rpc.ts",
    "benchmark:identity": "tsx scripts/benchmark-visual-identity.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:local": "supabase migration up --local --workdir ../..",
    "db:reset:local": "supabase db reset --local --workdir ../..",
    "db:schema:sql": "drizzle-kit export --config drizzle.config.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@orpc/server": "1.15.0",
    "@snap/protocol": "workspace:*",
    "ai": "^7.0.70",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.3",
    "postgres": "3.4.9",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@orpc/client": "1.15.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
